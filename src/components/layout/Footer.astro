<script>
  // Contour lines "plot" themselves in, like a drafting instrument, the first time the
  // footer scrolls into view. Respects prefers-reduced-motion; falls back to fully drawn.
  const paths = document.querySelectorAll<SVGPathElement>('.contour-draw path');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  paths.forEach((p, i) => {
    const len = p.getTotalLength();
    p.style.strokeDasharray = String(len);
    p.style.strokeDashoffset = reduceMotion ? '0' : String(len);
    p.style.transition = reduceMotion ? 'none' : `stroke-dashoffset 1.3s ease ${i * 0.1}s`;
  });

  if (!reduceMotion && paths.length) {
    const target = document.querySelector('.footer-art');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            paths.forEach((p) => (p.style.strokeDashoffset = '0'));
            io.disconnect();
          }
        }
      },
      { threshold: 0.1 }
    );
    if (target) io.observe(target);
  }
</script>
