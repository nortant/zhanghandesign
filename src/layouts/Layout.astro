---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Han Zhang's personal site — surveying, mapping and landscape work, documented as I build it. Alberta, Canada.",
  image,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Han Zhang' ? title : `${title} · Han Zhang`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="site-bg" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // A faint contour texture behind the whole site drifts slower than the page
      // scrolls, for a gentle sense of depth. Skipped entirely for
      // prefers-reduced-motion — the texture stays put, just doesn't move.
      const bg = document.querySelector<HTMLElement>('.site-bg');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (bg && !reduceMotion) {
        let ticking = false;
        const update = () => {
          bg.style.transform = `translateY(${window.scrollY * 0.035}px)`;
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>
