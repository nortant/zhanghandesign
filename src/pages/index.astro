---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---

<Layout
  title="Han Zhang"
  description="Han Zhang — surveying, mapping and landscape work, documented as I go. Alberta, Canada."
>
  <section class="page-hero">
    <div class="wrap-wide">
      <p class="eyebrow">Alberta, Canada</p>
      <h1>Han Zhang</h1>
      <p class="lede">I document survey, mapping and landscape work here as I build it — some pieces finished, some
        still in progress. Every project runs end to end from raw data to a checked, finished drawing, and I show
        the checks alongside the result, not just the polish.</p>
      <div class="btns">
        <a class="btn primary" href="#projects">See the work</a>
        <a class="btn" href="/about/">About</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap-wide">
      <div class="section-head">
        <h2 style="margin-top:0">How this works</h2>
        <p>Nine years of construction-drawing production in China taught the drafting discipline. After moving to
          Alberta, I've been rebuilding that discipline around Canadian data, standards and coordinate systems — the
          projects below are the result.</p>
      </div>
      <div class="grid cards">
        <div class="card">
          <h3>Open source first</h3>
          <p style="margin:0;color:var(--muted);font-size:0.92rem">Every project runs end-to-end on open tools (QGIS, PDAL/GDAL, Python) before I touch anything commercial, so the
            pipeline stays inspectable — I can show exactly how a result was produced, not just claim it.</p>
        </div>
        <div class="card">
          <h3>Standards, not guesses</h3>
          <p style="margin:0;color:var(--muted);font-size:0.92rem">Design values come from the actual municipal and provincial standards, read before drawing starts and kept
            with their source document and page.</p>
        </div>
        <div class="card">
          <h3>Checked, including the mistakes</h3>
          <p style="margin:0;color:var(--muted);font-size:0.92rem">Every automated step gets an independent check, and I publish the check results as they are — including where
            the first pass got something wrong.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="wrap-wide">
      <div class="section-head">
        <h2 style="margin-top:0">Projects</h2>
        <p>Six pieces spanning survey drafting, geomatics and landscape construction. Two are finished with full
          drawing sets, interactive maps and downloads; the rest are underway.</p>
      </div>
      <div class="grid cards cards-projects">
        {projects.map((p) => (
          p.href ? (
            <a class="card proj-card" href={p.href}>
              <div class="proj-card-top">
                <span class="proj-card-id">{p.id}</span>
                <span class="status">Ready</span>
              </div>
              <h3>{p.title}</h3>
              <p class="role">{p.focus}</p>
              <p class="summary">{p.summary}</p>
            </a>
          ) : (
            <div class="card proj-card">
              <div class="proj-card-top">
                <span class="proj-card-id">{p.id}</span>
                <span class="status planned">In progress</span>
              </div>
              <h3>{p.title}</h3>
              <p class="role">{p.focus}</p>
              <p class="summary">{p.summary}</p>
            </div>
          )
        ))}
      </div>
    </div>
  </section>
</Layout>
