---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const earlyExperience = (await getCollection('earlyExperience')).sort((a, b) => a.data.order - b.data.order);

const coreSkills = ['AutoCAD', 'SketchUp', 'Adobe Photoshop', 'Microsoft Office', 'Construction-drawing detailing'];
const geoSkills = [
  'QGIS', 'PDAL / GDAL', 'Python (ezdxf, geopandas, shapely, laspy)',
  'NAD83(CSRS) / CGVD2013 coordinate systems', 'CAD standards & field-code libraries', 'Civil 3D (in progress)',
];
---

<Layout
  title="About"
  description="Han Zhang — survey CAD and landscape technician, nine years of construction-drawing production experience, now based in Alberta building a Canadian-standards portfolio."
>
  <section class="page-hero">
    <div class="wrap-wide">
      <p class="eyebrow">About</p>
      <h1>Han Zhang</h1>
      <p class="lede">Survey CAD &amp; Landscape Technician, based in Alberta, Canada. Nine years of construction-drawing
        production experience in China, now applied to Canadian coordinate systems, municipal standards and CAD
        conventions through the reproducible portfolio projects on this site.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap-wide">
      <div class="section-head">
        <h2 style="margin-top:0">Background</h2>
      </div>
      <p style="max-width:70ch">
        Entered the landscape industry in 2017 as a site-based drafter, following construction crews and learning
        firsthand where a drawing stops matching what actually gets built. That gap became the focus: translating a
        designer's intent into drawings a construction crew can build from, a material supplier can quote from, and a
        site inspector can check — production drafting, not concept design. Over the following years this covered
        residential, community, hotel and waterfront landscape projects across several cities in China (see
        <a href="#early-experience">Early experience</a> below).
      </p>
      <p style="max-width:70ch;margin-top:12px">
        Since relocating to Alberta, that same drafting discipline is being rebuilt around Canadian data: NAD83(CSRS)
        coordinate systems, City of Calgary standards, and open geospatial tooling (QGIS, PDAL/GDAL, Python). The
        <a href="/projects/">Projects</a> page is the result — each one built and QA'd end to end, not just claimed.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap-wide">
      <div class="section-head">
        <h2 style="margin-top:0">Skills</h2>
      </div>
      <div class="grid cards">
        <div class="card skills-group">
          <h3>Drafting &amp; production (China, 2017–)</h3>
          <div class="skills-pills">
            {coreSkills.map((s) => <span class="skill-pill">{s}</span>)}
          </div>
        </div>
        <div class="card skills-group">
          <h3>Canadian geomatics stack (built in Alberta)</h3>
          <div class="skills-pills">
            {geoSkills.map((s) => <span class="skill-pill">{s}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="early-experience">
    <div class="wrap-wide">
      <div class="section-head">
        <h2 style="margin-top:0">Early experience</h2>
        <p>Construction-drawing production work in China, 2019–2023. Summarized here as background, not primary
          portfolio evidence — the <a href="/projects/">Projects</a> page is built specifically for Alberta roles.</p>
      </div>
      <div class="timeline">
        {earlyExperience.map((p) => (
          <div class="timeline-item">
            <div class="timeline-year">{p.data.year}</div>
            <div>
              <h3>{p.data.title}</h3>
              <p class="meta">{p.data.category} · {p.data.location} · {p.data.role}</p>
              <p class="summary">{p.data.summary}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
