---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
---

<Layout
  title="Projects"
  description="Survey, mapping and landscape projects: field data QA, coordinate systems, CAD standards and municipal-standard design, each built end to end from open data."
>
  <section class="page-hero">
    <div class="wrap-wide">
      <p class="eyebrow">Work</p>
      <h1>Projects</h1>
      <p class="lede">Every piece here is built end-to-end with open-source tools first; commercial software (Civil
        3D, Land F/X, Trimble Business Center) comes afterwards, for side-by-side comparison. Field observations are
        simulated from real open data where no live field work was possible, and labelled as such throughout.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap-wide">
      <div class="grid cards cards-projects">
        {projects.map((p) => (
          p.href ? (
            <a class="card proj-card" href={p.href}>
              <div class="proj-card-top">
                <span class="proj-card-id">{p.id}</span>
                <span class="status">Ready</span>
              </div>
              <h3>{p.title}</h3>
              <p class="role">{p.focus}</p>
              <p class="summary">{p.summary}</p>
            </a>
          ) : (
            <div class="card proj-card">
              <div class="proj-card-top">
                <span class="proj-card-id">{p.id}</span>
                <span class="status planned">In progress</span>
              </div>
              <h3>{p.title}</h3>
              <p class="role">{p.focus}</p>
              <p class="summary">{p.summary}</p>
            </div>
          )
        ))}
      </div>
    </div>
  </section>
</Layout>
