---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Han Zhang, Survey CAD and Landscape Technician based in Alberta."
>
  <section class="page-hero">
    <div class="wrap-wide">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="lede">Open to Survey CAD Technician, Geomatics Technician, Landscape Architectural Technician and GIS
        Technician roles in Alberta, and to remote or contract work while relocating within the province.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap-wide">
      <div class="contact-grid">
        <div class="contact-card">
          <h3>Email</h3>
          <a class="value" href="mailto:hello@zhanghandesign.com">hello@zhanghandesign.com</a>
        </div>
        <div class="contact-card">
          <h3>Location</h3>
          <p class="value" style="margin:0">Alberta, Canada</p>
          <p style="margin:4px 0 0;color:var(--muted);font-size:0.85rem">Calgary / Edmonton preferred; open to relocation within Alberta</p>
        </div>
        <div class="contact-card">
          <h3>Availability</h3>
          <p class="value" style="margin:0">On-site or remote</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
