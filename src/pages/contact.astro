---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Han Zhang."
>
  <section class="page-hero">
    <div class="wrap-wide">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="lede">Questions about a project on this site, collaboration, or work — email is the best way to
        reach me.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap-wide">
      <div class="contact-grid">
        <div class="contact-card">
          <h3>Email</h3>
          <a class="value" href="mailto:zerozhzh1988@gmail.com">zerozhzh1988@gmail.com</a>
        </div>
        <div class="contact-card">
          <h3>Location</h3>
          <p class="value" style="margin:0">Alberta, Canada</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
